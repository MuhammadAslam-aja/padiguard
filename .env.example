# ============================================================
# DATABASE MYSQL (Railway MySQL Service)
# Isi nilai-nilai ini dari Railway dashboard -> Variables
# ============================================================
DB_HOST=your-mysql-host.railway.internal
DB_PORT=3306
DB_NAME=railway
DB_USER=root
DB_PASS=your-password

# ============================================================
# GEMINI AI API KEY
# ============================================================
GEMINI_API_KEY=your_gemini_api_key_here

# ============================================================
# ROBOFLOW API KEY
# ============================================================
ROBOFLOW_API_KEY=nsRtr9srM0kLon24RWka

# ============================================================
# APP CONFIG
# ============================================================
APP_ENV=production
APP_URL=https://your-app.up.railway.app

# ============================================================
# EMAIL / SMTP (untuk fitur Lupa Password via OTP)
# Gunakan Gmail App Password (bukan password Gmail biasa!)
# Cara buat: myaccount.google.com -> Security -> App Passwords
# ============================================================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_gmail@gmail.com
MAIL_PASSWORD=xxxx xxxx xxxx xxxx
MAIL_FROM=your_gmail@gmail.com
MAIL_FROM_NAME=PadiGuard
